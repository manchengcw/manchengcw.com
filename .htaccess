# ==========================================================================
# MiniCity (Hongkong) Co., Limited — manchengcw.com
# Apache configuration
# ==========================================================================

# --------------------------------------------------------------------------
# 1. CANONICAL HOST + HTTPS
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS for every request
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Canonical host: strip www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /index.html -> /  (301 permanent)
  RewriteRule ^index\.html$ / [R=301,L]

  # Never expose the directory listing of the root
  Options -Indexes
</IfModule>

# --------------------------------------------------------------------------
# 2. DEFAULT DOCUMENT
# --------------------------------------------------------------------------
DirectoryIndex index.html

# --------------------------------------------------------------------------
# 3. CUSTOM ERROR PAGES
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# 4. GZIP COMPRESSION
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

# --------------------------------------------------------------------------
# 5. BROWSER CACHE HEADERS FOR STATIC ASSETS
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpe?g|webp|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --------------------------------------------------------------------------
# 6. MIME TYPES FOR SVG SPRITE
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/javascript .js
</IfModule>

# --------------------------------------------------------------------------
# 7. UTF-8 DEFAULT ENCODING
# --------------------------------------------------------------------------
AddDefaultCharset UTF-8
